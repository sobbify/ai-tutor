# Settings for `docker compose` — copy to .env next to docker-compose.yml (never commit .env).
# scripts/docker-check.ps1 creates this file for you with random secrets.
POSTGRES_PASSWORD=change-me-long-random
GEMINI_API_KEYS=                 # billed key(s) for the pilot; comma-separated
EVALUATOR=gemini                 # or "rules" to try it offline
HOST_API_KEY=change-me-long-random   # Buddy's World uses this for GET /api/host/nudges
COOKIE_SECURE=true
SCHOOL_TIMEZONE=Asia/Kolkata
