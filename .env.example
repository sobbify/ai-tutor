# Frontend build mode.
# "http"  → talks to the FastAPI backend (what run.py and Docker use)
# "mock"  → runs entirely in the browser with demo data (UI work without a backend)
VITE_API_MODE=http
# Leave empty: the backend serves the app on the same origin.
VITE_API_BASE_URL=
# Dev only: where Vite proxies /in and /api.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
