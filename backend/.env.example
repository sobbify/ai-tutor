# AI Tutor backend settings. Copy to backend/.env (git-ignored). Every value can also be an env var.

ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO
LOG_JSON=true

# Database — SQLite by default (file in backend/data/). For production use PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://tutor:CHANGE_ME@db:5432/tutor
# DATABASE_URL=sqlite+aiosqlite:///./data/tutor.db
AUTO_MIGRATE=true                  # run migrations at startup (single instance)

# Reply checking: "gemini" (needs keys) or "rules" (offline stand-in, for demos/tests)
EVALUATOR=gemini
GEMINI_API_KEYS=                   # one or more keys: comma-separated or a JSON list
GEMINI_BACKEND=gemini              # gemini | vertex | auto | vertex-adc
GEMINI_EVAL_MODEL=gemini-flash-latest,gemini-flash-lite-latest   # fallback checker chain (tried in order)

# Realtime audio (Gemini Live — same model and voices as the Live tutor)
GEMINI_LIVE_MODEL=gemini-3.8-live
LIVE_LISTEN=true                   # stream replies to Gemini Live (feedback ~1 s after Stop)
VOICE_ENABLED=true                 # parent lines in Gemini's voice (false = browser voice)
PARENT_VOICE=Kore
COACH_VOICE=Aoede
VOICE_PREWARM=true                 # record every line in the background at startup
# VOICE_CACHE_DIR=./data/voice
MAX_LISTEN_SECONDS=60
MAX_STORY_SECONDS=120              # "Tell me what happened"

# Programme: school days, streak and reminders run on the school's clock
SCHOOL_TIMEZONE=Asia/Kolkata

# Reminders: Buddy's World fetches due reminders from GET /api/host/nudges with this bearer key.
# Empty = feed off. Use a long random value.
HOST_API_KEY=
# Signed entry links (required in production): Buddy's World signs /in?…&ts=…&sig=… with this.
# Empty in development = plain /in?uid=…&name=… links work. See docs/HOST-INTEGRATION.md.
ENTRY_LINK_SECRET=
# ENTRY_LINK_MAX_AGE_SECONDS=300
# First admin for container deployments (created at startup only if no admin exists yet):
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD=

# Learner sessions (the host app opens /in?uid=..&name=..)
SESSION_TTL_HOURS=168
SESSION_ABSOLUTE_DAYS=30
# COOKIE_SECURE=true               # default: on in production
IN_PER_MINUTE_IP=30
REPLY_RATE_PER_MINUTE=20
MAX_AUDIO_MB=10

# Admin console
ADMIN_SESSION_HOURS=8
ADMIN_LOGIN_PER_MINUTE_IP=5
LOCKOUT_AFTER_FAILURES=8
LOCKOUT_MINUTES=15

# Only if the API is called from another origin (normally not needed — same origin):
# ALLOWED_ORIGINS=https://app.example.com
# EMBED_ORIGINS=https://host-app.example   # only if the host app shows AI Tutor in an <iframe>
